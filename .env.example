# ==============================================================================
# SHOP:SELL MARKETPLACE — HOSTED ENVIRONMENT CONFIGURATION
# (NO DOCKER: Supabase + Upstash Redis + Typesense Cloud + Cloudflare R2 + Razorpay)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & PORTS
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
# Frontend API URL: Leave empty to use relative URLs (/api/...) via frontend dev proxy or Nginx reverse proxy
NEXT_PUBLIC_API_URL=
# Backend target URL for Next.js development rewrites proxy
API_PROXY_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SELLER_URL=http://localhost:3000/seller
NEXT_PUBLIC_ADMIN_URL=http://localhost:3000/admin

# ------------------------------------------------------------------------------
# 2. HOSTED SUPABASE (PostgreSQL 16 + pgvector + RLS + Auth)
# Free Tier Signup: https://supabase.com
# Create a project -> Project Settings -> Database -> Connection String (URI, pooling mode: Transaction)
# ------------------------------------------------------------------------------
# Transaction pooler URL (PgBouncer - Port 6543)
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?sslmode=require
# Direct connection URL (Session - Port 5432, for migrations/DDL)
DATABASE_DIRECT_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres?sslmode=require

# Project Settings -> API
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Supabase JWT Secret (minimum 32 bytes in production if used for signing or verifying)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here-min-32-chars

# Next.js Client Exposure
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 3. UPSTASH REDIS (Serverless Redis for Cache, Feed, Rate Limiting & BullMQ)
# Free Tier Signup: https://upstash.com
# Create Database -> Node.js (ioredis) or REST Details
# ------------------------------------------------------------------------------
# Upstash Redis Connection URI with TLS (starts with rediss://)
REDIS_URL=rediss://default:[YOUR-UPSTASH-PASSWORD]@[YOUR-ENDPOINT].upstash.io:6379

# Optional fallback host/port (if connecting without single URI string)
REDIS_HOST=[YOUR-ENDPOINT].upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=[YOUR-UPSTASH-PASSWORD]

# Optional Upstash REST API (for edge functions)
UPSTASH_REDIS_REST_URL=https://[YOUR-ENDPOINT].upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# ------------------------------------------------------------------------------
# 4. TYPESENSE CLOUD (Typo-Tolerant Search & Autocomplete)
# Free / Trial Signup: https://cloud.typesense.org
# Cluster Dashboard -> Generate API Keys
# ------------------------------------------------------------------------------
TYPESENSE_HOST=[YOUR-CLUSTER-ID].a1.typesense.net
TYPESENSE_PORT=443
TYPESENSE_PROTOCOL=https
TYPESENSE_API_KEY=your_typesense_admin_api_key

# Public Search-Only Key for Client Autocomplete
NEXT_PUBLIC_TYPESENSE_HOST=[YOUR-CLUSTER-ID].a1.typesense.net
NEXT_PUBLIC_TYPESENSE_PORT=443
NEXT_PUBLIC_TYPESENSE_PROTOCOL=https
NEXT_PUBLIC_TYPESENSE_SEARCH_ONLY_API_KEY=your_typesense_search_only_api_key

# ------------------------------------------------------------------------------
# 5. PAYMENTS — RAZORPAY (INR)
# Test Account: https://dashboard.razorpay.com
# Settings -> API Keys -> Generate Test Key
# Settings -> Webhooks -> Add Webhook (Events: payment.captured, order.paid)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_yourkeyidhere
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_yourkeyidhere

# ------------------------------------------------------------------------------
# 6. OBJECT STORAGE — CLOUDFLARE R2 (Zero Egress Image Storage & CDN)
# Cloudflare Dashboard -> R2 -> Create Bucket -> Manage R2 API Tokens
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=shopsell-product-media
R2_PUBLIC_DOMAIN=https://media.shopsell.example.com

# ------------------------------------------------------------------------------
# 7. RECOMMENDATION ENGINE HYPERPARAMETERS
# ------------------------------------------------------------------------------
REC_DECAY_HALF_LIFE_DAYS=7
REC_CACHE_TTL_SECONDS=300
REC_MAX_RECENT_SEARCHES=50
REC_MAX_RECENT_VIEWS=100
REC_VECTOR_DIMENSION=384

# ------------------------------------------------------------------------------
# 8. FIREBASE AUTHENTICATION (PHONE NUMBER SIGN-IN & IDENTITY)
# Firebase Console: https://console.firebase.google.com/
# ------------------------------------------------------------------------------
# Frontend Client Web SDK (apps/web)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_web_app_id

# Backend Server Firebase Admin SDK (apps/api - NEVER expose via NEXT_PUBLIC_*)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 9. SECURITY, AUTHENTICATION & CLOUDFLARE TURNSTILE
# ------------------------------------------------------------------------------
# Shared symmetric secret for HS256 JWT verification across apps/api and apps/web
JWT_SECRET=super-secret-jwt-token-with-minimum-32-characters-long

# Dedicated administrative JWT secret (minimum 32 bytes, strictly distinct from JWT_SECRET in production)
# Generate with: openssl rand -hex 32
ADMIN_JWT_SECRET=your-admin-jwt-secret-here-min-32-chars

# Shared secret for web proxy -> apps/api internal authentication (minimum 32 bytes)
# Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=your-internal-api-secret-here-min-32-chars

# Dedicated secret for HMAC-SHA256 privacy-preserving security logging (minimum 32 bytes)
# Generate with: openssl rand -hex 32
LOG_HASH_KEY=your-log-hash-secret-here-min-32-chars

# Cloudflare Turnstile bot protection
# Testing dummy keys:
# Site Key: 1x00000000000000000000AA (always passes)
# Secret Key: 1x0000000000000000000000000000000AA (always passes)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Demo account bypass guard (MUST be 'false' or omitted in production)
# Throws fatal startup error if enabled when NODE_ENV === 'production'
ENABLE_DEMO_ACCOUNTS=false
NEXT_PUBLIC_ENABLE_DEMO_ACCOUNTS=false

# ------------------------------------------------------------------------------
# 10. EMAIL OTP AUTHENTICATION (GMAIL SMTP or RESEND)
# ------------------------------------------------------------------------------
# Option A: Gmail SMTP with App Password (instant delivery to all addresses)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password

# Option B: Resend (fallback)
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM="Shop:Sell <onboarding@resend.dev>"

# ------------------------------------------------------------------------------
# 11. GOOGLE OAUTH
# Google Cloud Console -> Credentials -> OAuth 2.0 Client IDs
# Authorized Redirect URI: [YOUR_SITE_URL]/api/auth/callback/google
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 12. CORS & DOMAINS
# ------------------------------------------------------------------------------
# Comma-separated allowed frontend origins for production API CORS
CORS_ORIGIN=https://shopsell.example.com
FRONTEND_URL=https://shopsell.example.com

