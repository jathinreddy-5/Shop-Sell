{
  "name": "@shop-sell/web",
  "version": "1.0.0",
  "private": true,
  "description": "Next.js App Router frontend for Shop:Sell marketplace",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev -p 3008 || node ../../node_modules/next/dist/bin/next dev -p 3008",
    "build": "next build || node ../../node_modules/next/dist/bin/next build",
    "start": "next start -p 3008 || node ../../node_modules/next/dist/bin/next start -p 3008",
    "lint": "next lint || node ../../node_modules/next/dist/bin/next lint",
    "test": "node --experimental-strip-types --test src/__tests__/**/*.spec.ts"
  },
  "dependencies": {
    "@shop-sell/shared": "file:../../packages/shared",
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "lucide-react": "^0.475.0",
    "motion": "^13.5.1",
    "next": "^15.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
