{
  "name": "@shop-sell/api",
  "version": "1.0.0",
  "private": true,
  "description": "NestJS backend API for Shop:Sell marketplace",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "node ../../node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "node --watch dist/main.js",
    "start:prod": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "test": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json && node --test dist/__tests__/*.spec.js",
    "test:integration": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json && node --test --test-reporter=./dist/__tests__/integration/reporter.js dist/__tests__/integration/live-services.spec.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1142.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@shop-sell/shared": "file:../../packages/shared",
    "bullmq": "^6.3.10",
    "firebase-admin": "^14.5.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.0.16",
    "pg": "^8.13.1",
    "razorpay": "^2.9.8",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typesense": "^3.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/ioredis": "^4.28.10",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.13.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.2"
  }
}
